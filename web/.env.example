# Copy to .env and fill in. For local Supabase, `supabase start` prints these values.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key

# Vercel の関数（web/api/）が読む値。画面には出さないので VITE_ を付けない。
# ローカルの issuer は ${SUPABASE_URL}/auth/v1 になるため、localhost ではなく 127.0.0.1 にする。
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
